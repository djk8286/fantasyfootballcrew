APP_NAME=FantasyFootballCrew
DATABASE_URL=sqlite+aiosqlite:///./ffc.db
CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET=change-me-to-a-random-secret-key
SLEEPER_API_BASE=https://api.sleeper.app/v1

# "development" locally; set to "production" on Railway (used to tag
# Sentry events by environment -- see SENTRY_DSN below).
ENVIRONMENT=development

# AI Service (optional - set at least one)
# OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Supabase (optional - for production)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key

# Password-reset emails (optional). Without this, reset links are logged
# server-side instead of emailed -- still fully functional, just needs
# manual delivery until this is set. See app/services/email_service.py.
# RESEND_API_KEY=re_your-key-here
# RESEND_FROM_EMAIL=FantasyFootballCrew <onboarding@resend.dev>

# Used to build the link inside password-reset emails.
FRONTEND_URL=http://localhost:3000

# Error monitoring (optional). Without a DSN, sentry_sdk is never
# initialized -- no-op, no dependency on this being set at all. See
# app/core/sentry.py.
# SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
