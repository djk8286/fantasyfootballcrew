# Copy to .env.local and fill in as needed. Without this file at all,
# `npm run dev` alone talks to a relative (same-origin) API path instead
# of the backend -- use the dev:all script, or set this, to actually
# reach a local backend on a different port.
NEXT_PUBLIC_API_URL=http://localhost:8001

# Supabase (optional -- only needed if using Supabase auth integration).
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Error monitoring (optional). Without a DSN, the Sentry SDK never
# actually reports anything -- see src/instrumentation.ts /
# src/instrumentation-client.ts.
# NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0

# Google AdSense (optional). Without BOTH set, AdSlot (src/components/
# AdSlot.tsx) renders nothing at all -- no placeholder, no layout
# change -- so this is purely a config flip when ready, no code change.
# Also widens the CSP (next.config.ts) to allow AdSense's script/frame/
# connect domains, but only when these are set.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_ID=XXXXXXXXXX
